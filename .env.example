# تصميم م. أبو أحمد — مصمم ومنفذ Claude — © الحقوق محفوظة
#
# انسخ هذا الملف إلى .env ثم عبّئ القيم. لا ترفع .env إلى GitHub أبدًا.

# ========================================================
# الخادم
# ========================================================
# منفذ التشغيل (تفرضه بعض المنصات مثل Cloud Run وManus)
PORT=3000

# كلمة مرور المدير العام لأول تشغيل (8 خانات على الأقل).
# إن تُركت فارغة تُولَّد كلمة عشوائية تظهر مرة واحدة في سجل الخادم
# وفي data/FIRST_RUN_ADMIN_PASSWORD.txt، وسيُطلب منك تغييرها عند أول دخول.
ADMIN_INITIAL_PASSWORD=

# ========================================================
# اختياري
# ========================================================
# GEMINI_API_KEY="..."
# APP_URL="https://your-domain.example"

# ========================================================
# Firebase (Firestore & Authentication) — اختياري، المزامنة السحابية الإضافية
# من Firebase Console > Project Settings > General > Your apps (Web)
# ========================================================
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
